# AWS runtime profile/region
AWS_PROFILE=stack-research
AWS_REGION=us-east-2

# Retrieval-plane (S3 Vectors)
AWS_VECTOR_BUCKET_NAME=experimental-memory
AWS_VECTOR_INDEX_NAME=memories-v1

# Source-of-truth and materialized state
AWS_EVENTS_BUCKET_NAME=experimental-memory-events
AWS_STATE_BUCKET_NAME=experimental-memory-state

# Cold analytics path
AWS_ANALYTICS_BUCKET_NAME=experimental-memory-analytics
